// Leviva Travel data model
// Default uses SQLite for zero-config local dev / quick deploys.
// For production switch the provider to "postgresql" and update DATABASE_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Destination {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  country     String
  tagline     String
  description String
  heroImage   String
  highlights  String
  tours       Tour[]
  createdAt   DateTime @default(now())
}

model Tour {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  summary       String
  description   String
  durationDays  Int
  priceUsd      Int
  ratingAvg     Float    @default(4.9)
  reviewsCount  Int      @default(0)
  heroImage     String
  gallery       String
  inclusions    String
  exclusions    String
  itinerary     String
  difficulty    String   @default("Easy")
  category      String   @default("Safari")
  featured      Boolean  @default(false)
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id])
  bookings      Booking[]
  createdAt     DateTime @default(now())
}

model Booking {
  id              String   @id @default(cuid())
  reference       String   @unique
  tourId          String?
  tour            Tour?    @relation(fields: [tourId], references: [id])
  fullName        String
  email           String
  phone           String
  country         String
  travelers       Int
  startDate       DateTime
  message         String?
  status          String   @default("pending")
  estimateUsd     Int      @default(0)
  source          String?
  createdAt       DateTime @default(now())
}

model Inquiry {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  country   String?
  subject   String
  message   String
  createdAt DateTime @default(now())
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  country   String?
  createdAt DateTime @default(now())
}

model Review {
  id        String   @id @default(cuid())
  author    String
  country   String
  rating    Int
  comment   String
  tourSlug  String?
  createdAt DateTime @default(now())
}
