generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model BookingLead {
  id                 String   @id @default(cuid())
  fullName           String
  email              String
  phone              String
  sourceMarket       String
  residenceCountry   String
  travelerCount      Int
  tripLength         String
  startDate          DateTime?
  destinations       String
  interests          String
  budgetRange        String
  accommodationStyle String
  notes              String?
  consent            Boolean
  status             String   @default("NEW")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([createdAt])
  @@index([status])
}
